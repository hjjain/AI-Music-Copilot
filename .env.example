# ===============================================
# YT Music Autopilot - Environment Variables
# ===============================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# -----------------------------------------------
# SUNO API Configuration (Required)
# -----------------------------------------------
# Get your API key from acedata.cloud
SUNO_API_KEY=your_suno_api_key_here
SUNO_API_URL=https://api.acedata.cloud/suno/audios
SUNO_TIMING_URL=https://api.acedata.cloud/suno/timing
SUNO_MODEL=chirp-v4

# -----------------------------------------------
# REPLICATE API Configuration (Required)
# -----------------------------------------------
# Get your API token from replicate.com
REPLICATE_API_TOKEN=your_replicate_api_token_here

# -----------------------------------------------
# YOUTUBE API Configuration (Optional)
# -----------------------------------------------
# Required only if you want automatic YouTube uploads
# Setup instructions:
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create a new project or select existing one
# 3. Enable "YouTube Data API v3"
# 4. Go to Credentials > Create Credentials > OAuth client ID
# 5. Application type: Web application
# 6. Add authorized redirect URI: http://localhost:3000/api/youtube/callback
# 7. Copy Client ID and Client Secret below

YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# This will be set after completing OAuth flow via the Settings page
YOUTUBE_REFRESH_TOKEN=

# -----------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
